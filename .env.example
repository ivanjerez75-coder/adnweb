# IA (al menos una). Clave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cadena de modelos Gemini (se prueban en orden si uno está saturado o retirado).
# Modelos disponibles: https://ai.google.dev/gemini-api/docs/models
# Ojo: si existe GEMINI_MODEL (ajuste antiguo), ese modelo va primero y tiene prioridad sobre GEMINI_MODELS.
GEMINI_MODELS=gemini-3.5-flash,gemini-flash-lite-latest
# Respaldo gratuito: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Opcionales (gratuitas)
CLOUDFLARE_RADAR_TOKEN=
# Sin clave, PageSpeed agota enseguida el cupo diario compartido (error 429).
# Clave gratuita: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
# Cuentas (Supabase, plan gratuito): https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: solo servidor, nunca en el navegador
SUPABASE_SERVICE_ROLE_KEY=
# Dirección pública de la web (login). Producción: https://tudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3100
